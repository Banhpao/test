# YumeAI đọc biến môi trường trực tiếp; dự án local-first không cần API key trả phí.
# Bash: export OLLAMA_MODEL=qwen3:4b-instruct
# PowerShell: $env:OLLAMA_MODEL="qwen3:4b-instruct"

# Ollama trên ổ rời (MO-PAOCAKE.cmd tự đặt): http://127.0.0.1:11435
OLLAMA_URL=http://127.0.0.1:11434
# Model chat (D24). qwen2.5:3b nhanh hơn ~4 lần trên GPU 4 GB nhưng giữ vai kém hơn.
OLLAMA_MODEL=qwen3:4b-instruct
COMFY_URL=http://127.0.0.1:8188
# Để trống = tự dò theo tên model đã pull. Đặt để ép đúng model.
# YUMEAI_VISION_MODEL=qwen2.5vl:3b
# YUMEAI_TRANSLATE_MODEL=qwen2.5:3b

# Mặc định dữ liệu nằm ở project/data/ (đã được gitignore).
# Chỉ đặt hai biến dưới nếu muốn DB/ảnh nằm ở ổ khác để backup dễ hơn.
# YUMEAI_DATA_DIR=D:\YumeAIData
# YUMEAI_DATABASE_PATH=D:\YumeAIData\yumeai.db
# YUMEAI_GENERATED_IMAGES_DIR=D:\YumeAIData\images

YUMEAI_CHAT_NUM_CTX=4096
YUMEAI_CHAT_HISTORY_MAX=12
# Tóm tắt hội thoại cũ vào prompt: tắt mặc định (D29) — chậm trên GPU 4 GB, fact đã đủ.
YUMEAI_CHAT_SUMMARY=0
YUMEAI_CHAT_FEWSHOT=1

# Fact memory chạy nền theo lô để máy yếu không phải gọi LLM sau mỗi tin nhắn.
YUMEAI_MEMORY_FACTS=1
YUMEAI_MEMORY_EVERY=12
YUMEAI_MEMORY_BATCH_SIZE=24
YUMEAI_MEMORY_TIMEOUT_SEC=90

YUMEAI_COMFY_TIMEOUT_SEC=1800
YUMEAI_LOW_VRAM_MODE=1

# Ollama và ComfyUI dùng chung một GPU: trước job ComfyUI nhả model Ollama khỏi VRAM,
# trước bước vision nhờ ComfyUI /free. "0" để tắt.
YUMEAI_VRAM_HANDOFF=1
# Để trống = Ollama tự quyết. "0" = Ollama chạy hẳn CPU/RAM, nhường VRAM cho ComfyUI.
# YUMEAI_OLLAMA_NUM_GPU=0

# Số đo hiệu năng thật (token/giây, thời gian vẽ) → data/perf.jsonl, xem ở /api/stats.
# Chỉ có số và tên model/preset, không có nội dung tin nhắn hay prompt. "0" để tắt.
YUMEAI_PERF_LOG=1
