# YumeAI đọc biến môi trường trực tiếp; dự án local-first không cần API key trả phí.
# Bash: export OLLAMA_MODEL=qwen2.5:3b
# PowerShell: $env:OLLAMA_MODEL="qwen2.5:3b"

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
COMFY_URL=http://127.0.0.1:8188

# Mặc định dữ liệu nằm ở project/data/ (đã được gitignore).
# Chỉ đặt hai biến dưới nếu muốn DB/ảnh nằm ở ổ khác để backup dễ hơn.
# YUMEAI_DATA_DIR=D:\YumeAIData
# YUMEAI_DATABASE_PATH=D:\YumeAIData\yumeai.db
# YUMEAI_GENERATED_IMAGES_DIR=D:\YumeAIData\images

YUMEAI_CHAT_NUM_CTX=4096
YUMEAI_CHAT_HISTORY_MAX=12
YUMEAI_CHAT_SUMMARY=1
YUMEAI_CHAT_FEWSHOT=1

# Fact memory chạy nền theo lô để máy yếu không phải gọi LLM sau mỗi tin nhắn.
YUMEAI_MEMORY_FACTS=1
YUMEAI_MEMORY_EVERY=12
YUMEAI_MEMORY_BATCH_SIZE=24
YUMEAI_MEMORY_TIMEOUT_SEC=90

YUMEAI_COMFY_TIMEOUT_SEC=1800
YUMEAI_LOW_VRAM_MODE=1
